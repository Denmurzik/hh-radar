# --- доступ к API hh.ru -------------------------------------------------
# GET /vacancies закрыт для анонимных запросов: hh отвечает 403 bad_authorization.
# Нужен токен приложения. Как получить:
#   1. https://dev.hh.ru/admin -> «Создать приложение»
#   2. скопировать Client ID и Client Secret сюда
# Токен по client_credentials запрашивается автоматически и кэшируется на диск.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Альтернатива: положить готовый access_token и не заполнять пару выше.
# HH_ACCESS_TOKEN=

# hh требует представляться. Укажите имя приложения и способ связи.
HH_USER_AGENT=hh-radar/0.4 (github.com/Denmurzik/hh-radar)

# --- база ---------------------------------------------------------------
# Совпадает с docker-compose.yml. Порт 5433, чтобы не мешать локальному Postgres.
DATABASE_URL=postgresql+psycopg://hh:hh@localhost:5433/hh_radar

# --- эмбеддинги ---------------------------------------------------------
# fastembed — настоящая модель (скачивается при первом запуске, ~220 МБ).
# hash — детерминированная заглушка без скачивания, для CI и быстрых прогонов.
EMBEDDING_BACKEND=fastembed

# --- профиль кандидата --------------------------------------------------
# Файл в .gitignore. Скопируйте profile.example.yaml и заполните своими данными.
PROFILE_PATH=profile.yaml
